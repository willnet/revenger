<% title '確認メールの再送 - revenger' %>

<%= form_for(resource, as: resource_name, url: confirmation_path(resource_name), method: :post, html: { class: 'form-horizontal' }) do |f| %>
  <fieldset>
    <legend>確認メールの再送</legend>
    <p>ユーザ登録を行ったにもかかわらずメールが届かない場合は、登録確認メールを再送させていただきます。</p>
    <%= render 'errors', model: resource %>
    <div class="control-group">
      <%= f.label :email, class: 'control-label' %>
      <div class="controls">
        <%= f.email_field :email %>
      </div>
    </div>
    <div class="control-group form-actions">
      <%= f.submit '確認メールの再送', class: 'btn btn-success' %>
    </div>
  </fieldset>
<% end %>
