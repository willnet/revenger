<% title 'パスワードを忘れた場合 - revenger' %>

<div class="well">
  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: 'form-horizontal' }) do |f| %>
    <fieldset>
      <legend>パスワードを忘れた場合</legend>
      <p class="form-instruction">ユーザ登録をした時のメールアドレスを入力してください。メールにてパスワード再設定用のURLをお送りします。</p>
      <%= render 'errors', model: resource %>
      <div class="control-group">
        <%= f.label :email, class: 'control-label' %>
        <div class="controls">
          <%= f.email_field :email %>
        </div>
      </div>
      <div class="control-group form-actions">
        <%= f.submit '送信', class: 'btn btn-success' %>
      </div>
    </fieldset>
  <% end %>
</div>
