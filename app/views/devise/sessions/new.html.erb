<% title 'ログイン - revenger' %>

<%= form_for(resource, as: resource_name, url: login_path, html: { class: 'form-horizontal' }) do |f| %>
  <fieldset>
    <legend>ログイン</legend>
    <div class="control-group">
      <%= f.label :email, class: 'control-label' %>
      <div class="controls">
        <%= f.email_field :email %>
      </div>
    </div>
    <div class="control-group">
      <%= f.label :password, class: 'control-label' %>
      <div class="controls">
        <%= f.password_field :password %>
      </div>
    </div>
    <% if devise_mapping.rememberable? %>
      <div class="control-group">
        <div class="controls">
          <%= content_tag :label, class: 'checkbox' do %>
            <%= f.check_box :remember_me %>
            <%= t 'helpers.label.user.remember_me' %>
          <% end %>
        </div>
      </div>
    <% end %>
    <div class="control-group">
      <div class="controls">
        <%= link_to '※パスワードを忘れた場合', new_user_password_path %>
      </div>
    </div>
    <div class="control-group form-actions">
      <%= f.submit 'ログイン', class: 'btn btn-success' %>
    </div>
  </fieldset>
<% end %>
