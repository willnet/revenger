<% title 'リマインダメール設定 - revenger' %>

<div class="well">
  <%= form_for(@user, url: reminder_path, method: :put, html: { class: 'form-horizontal' }) do |f| %>
    <legend>
      リマインダメール設定
    </legend>
    <p>
      毎日送られてくるリマインダメールの送信／非送信を設定することができます
    </p>
    <%= render 'errors', model: @user %>
    <div class="control-group">
      <div class="controls">
        <label class="radio">
          <%= f.radio_button :receive_reminder, true %>
          送信する
        </label>
        <label class="radio">
          <%= f.radio_button :receive_reminder, false %>
          送信しない
        </label>
      </div>
    </div>
    <div class="control-group form-actions">
      <%= f.submit '更新', class: 'btn btn-success' %>
    </div>
  <% end %>
</div>
