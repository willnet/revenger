<% title '新規作成 - revenger' %>

<%= form_for(@post) do |f| %>
  <legend>
    新規作成
    <small class="pull-right">
      <%= link_to 'markdown 記法', help_path(anchor: 'how-to-write') %>
      が利用できます
    </small>
  </legend>
  <%= render 'errors', model: @post %>
  <%= f.text_area :body, id: 'post_body' %>
  <%= button_tag type: 'submit', class: 'btn btn-success', data: { turbo_submits_with: 'creating…' } do %>
    <%= icon('check-circle') %>
    create!
  <% end %>
<% end %>
