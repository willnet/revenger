<% duration_data = local_assigns[:reviewing] ? { review_target: 'duration', action: 'change->review#selectDuration' } : {} %>
<div class="duration btn-group" role="group" aria-label="復習間隔" data-behavior="duration">
  <% [[nil, 'no more'], [1, '1 day'], [7, '1 week'], [14, '2 week'], [30, '1 month'], [90, '3 months'], [180, '6 months'], [365, '1 year']].each do |value, label| %>
    <% id = "#{f.object_name}_#{post.id}_duration_#{value || 'none'}" %>
    <%= f.radio_button :duration, value.to_s, id: id, checked: post.duration == value, data: duration_data %>
    <%= label_tag id, label, class: 'btn btn-small' %>
  <% end %>
</div>
