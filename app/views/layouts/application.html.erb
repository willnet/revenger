<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8">
    <title><%= content_for?(:title) ? yield(:title) : 'revenger - 復習用メモサービス' %></title>
    <%= yield :head %>
    <%= javascript_importmap_tags %>
    <%= stylesheet_link_tag :application, 'data-turbo-track': 'reload' %>
    <%= csrf_meta_tags %>
  </head>
  <body class="<%= params[:controller] %>_controller <%= params[:action] %>_action">
    <%= render 'layouts/icons' %>
    <noscript>このページではJavaScriptを使用しています。JavaScriptを有効にしてください</noscript>
    <div id="root">
      <div class="navbar navbar-static-top">
        <div class="navbar-inner">
          <div class="container">
            <a class="brand" href="/">
              revenger
            </a>
            <div class="nav-collapse">
              <% if user_signed_in? %>
                <ul class="nav">
                  <li class="<%= current_page?(review_path) && 'active' %>"><%= link_to safe_join([icon('repeat'), ' レビュー']), review_path %></li>
                  <li class="<%= controller_name == 'posts' && (action_name == 'index' || action_name == 'show') && 'active' %>"><%= link_to safe_join([icon('book'), ' 一覧']), posts_path %></li>
                  <li class="<%= controller_name == 'posts' && (action_name == 'new' || action_name == 'create') && 'active' %>"><%= link_to safe_join([icon('pencil'), ' 新規作成']), new_post_path %></li>
                  <li class="dropdown <%= (controller_name == 'registrations' && (action_name.in? %w[edit retire]) || controller_name == 'durations') && 'active' %>" data-controller="dropdown" data-action="click@window->dropdown#close keydown.esc@window->dropdown#close">
                    <%= link_to safe_join([icon('settings'), ' 設定 ', content_tag(:b, '', class: 'caret')]), '#', class: 'dropdown-toggle', role: 'button', aria: { expanded: false }, data: { dropdown_target: 'toggle', action: 'dropdown#toggle:prevent:stop' } %>
                    <ul class="dropdown-menu">
                      <li><%= link_to 'ユーザ情報', edit_user_path %></li>
                      <li><%= link_to 'デフォルト復習間隔', edit_duration_path %></li>
                      <li><%= link_to 'リマインダメール', edit_reminder_path %></li>
                      <li><%= link_to '退会', user_retire_path %></li>
                    </ul>
                  </li>
                </ul>
                <ul class="nav pull-right">
                  <li class="divider-vertical"></li>
                  <li class="<%= current_page?(help_path) && 'active' %>"><%= link_to safe_join([icon('help'), ' ヘルプ']), help_path %></li>
                  <li><%= link_to safe_join([icon('log-out'), ' ログアウト']), logout_path, data: { turbo: false } %></li>
                </ul>
              <% else %>
                <ul class="nav pull-right">
                  <li class="<%= current_page?(signup_path) && 'active' %>"><%= link_to safe_join([icon('user-plus'), ' ユーザ登録']), signup_path %></li>
                  <li class="<%= current_page?(login_path) && 'active' %>"><%= link_to safe_join([icon('log-in'), ' ログイン']), login_path %></li>
                  <li class="<%= current_page?(help_path) && 'active' %>"><%= link_to safe_join([icon('help'), ' ヘルプ']), help_path %></li>
                </ul>
              <% end %>
            </div>
          </div>
        </div>
      </div>
      <%= flash_messages %>
      <%= content_for?(:content) ? yield(:content) : yield %>
      <div id="root_footer"></div>
    </div>
    <div id="footer">
      <ul class="footer-links">
        <li><%= link_to '利用規約', terms_path %></li>
        <li>・</li>
        <li><%= link_to 'プライバシーポリシー', privacy_path %></li>
      </ul>
      &copy; 2013 revenger.in. Created By <%= link_to '@netwillnet', 'http://twitter.com/netwillnet/' %>, <%= link_to 'willnet.in', 'http://www.willnet.in/' %>
    </div>
  </body>
</html>
