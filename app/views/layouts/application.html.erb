<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8">
    <title><%= content_for?(:title) ? yield(:title) : 'revenger - 復習用メモサービス' %></title>
    <%= javascript_include_tag :application %>
    <script src="//kit.fontawesome.com/b4fd638fdf.js"></script>
    <%= content_for?(:javascript) ? yield(:javascript) : '' %>
    <%= stylesheet_link_tag :application %>
    <link href='//fonts.googleapis.com/css?family=Gravitas+One' rel='stylesheet' type='text/css'>
    <%= cloudflare_turnstile_script_tag %>
    <%= csrf_meta_tags %>
    <script>
      I18n.defaultLocale = <%= I18n.default_locale.to_json.html_safe %>;
      I18n.locale = <%= I18n.locale.to_json.html_safe %>;
      (function(i,s,o,g,r,a,m){i['GoogleAnalyticsObject']=r;i[r]=i[r]||function(){
      (i[r].q=i[r].q||[]).push(arguments)},i[r].l=1*new Date();a=s.createElement(o),
      m=s.getElementsByTagName(o)[0];a.async=1;a.src=g;m.parentNode.insertBefore(a,m)
      })(window,document,'script','//www.google-analytics.com/analytics.js','ga');

      ga('create', 'UA-2159167-9', 'revenger.in');
      ga('send', 'pageview');
    </script>
  </head>
  <body class="<%= params[:controller] %>_controller <%= params[:action] %>_action">
    <noscript>このページではJavaScriptを使用しています。JavaScriptを有効にしてください</noscript>
    <div id="root">
      <div class="navbar navbar-static-top">
        <div class="navbar-inner">
          <div class="container">
            <a class="brand" href="/">
              revenger
            </a>
            <div class="nav-collapse">
              <% if user_signed_in? %>
                <ul class="nav">
                  <li class="<%= current_page?(review_path) && 'active' %>"><%= link_to '<i class="fas fa-repeat"></i> レビュー'.html_safe, review_path %></li>
                  <li class="<%= controller_name == 'posts' && (action_name == 'index' || action_name == 'show') && 'active' %>"><%= link_to '<i class="fas fa-book"></i> 一覧'.html_safe, posts_path %></li>
                  <li class="<%= controller_name == 'posts' && (action_name == 'new' || action_name == 'create') && 'active' %>"><%= link_to '<i class="fas fa-pencil-alt"></i> 新規作成'.html_safe, new_post_path %></li>
                  <li class="dropdown <%= (controller_name == 'registrations' && (action_name.in? %w[edit retire]) || controller_name == 'durations') && 'active' %>">
                    <%= link_to '<i class="fas fa-cog"></i> 設定 <b class="caret"></b>'.html_safe, '#', class: 'dropdown-toggle', 'data-toggle' => 'dropdown' %>
                    <ul class="dropdown-menu">
                      <li><%= link_to 'ユーザ情報', edit_user_path %></li>
                      <li><%= link_to 'デフォルト復習間隔', edit_duration_path %></li>
                      <li><%= link_to 'リマインダメール', edit_reminder_path %></li>
                      <li><%= link_to '退会', user_retire_path %></li>
                    </ul>
                  </li>
                </ul>
                <ul class="nav pull-right">
                  <li class="divider-vertical"></li>
                  <li class="<%= current_page?(help_path) && 'active' %>"><%= link_to '<i class="fas fa-question-circle"></i> ヘルプ'.html_safe, help_path %></li>
                  <li><%= link_to '<i class="fas fa-sign-out-alt"></i> ログアウト'.html_safe, logout_path %></li>
                </ul>
              <% else %>
                <ul class="nav pull-right">
                  <li class="<%= current_page?(signup_path) && 'active' %>"><%= link_to '<i class="fas fa-user-plus"></i> ユーザ登録'.html_safe, signup_path %></li>
                  <li class="<%= current_page?(login_path) && 'active' %>"><%= link_to '<i class="fas fa-sign-in-alt"></i> ログイン'.html_safe, login_path %></li>
                  <li class="<%= current_page?(help_path) && 'active' %>"><%= link_to '<i class="fas fa-question-circle"></i> ヘルプ'.html_safe, help_path %></li>
                </ul>
              <% end %>
            </div>
          </div>
        </div>
      </div>
      <%= flash_messages %>
      <%= content_for?(:content) ? yield(:content) : yield %>
      <div id="root_footer"></div>
    </div>
    <div id="footer">
      <ul class="footer-links">
        <li><%= link_to '利用規約', terms_path %></li>
        <li>・</li>
        <li><%= link_to 'プライバシーポリシー', privacy_path %></li>
      </ul>
      &copy; 2013 revenger.in. Created By <%= link_to '@netwillnet', 'http://twitter.com/netwillnet/' %>, <%= link_to 'willnet.in', 'http://www.willnet.in/' %>
    </div>
  </body>
</html>
