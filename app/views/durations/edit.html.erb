<% title 'デフォルト復習間隔 - revenger' %>

<div class="well">
  <%= form_for(@user, url: duration_path, method: :put, html: { class: 'form-horizontal' }) do |f| %>
    <legend>
      デフォルト復習間隔
    </legend>
    <p>
      新しいメモを作ったときに設定される復習の間隔を設定できます。
    </p>
    <%= render 'errors', model: @user %>
    <div class="control-group">
      <div class="control-label">
        デフォルト復習間隔
      </div>
      <div class="controls">
        <%= f.select(:default_duration, [1, 7, 14, 30, 90, 180, 365].map { |i| [i, i] }, {}, class: 'span1') %>
        日
      </div>
    </div>
    <div class="control-group form-actions">
      <%= f.submit '更新', class: 'btn btn-success' %>
    </div>
  <% end %>
</div>
